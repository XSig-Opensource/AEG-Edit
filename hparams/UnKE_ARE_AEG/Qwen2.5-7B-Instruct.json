{
    "model_name": "Qwen2.5-7B-Instruct",
    "layers": [7],
    "layer_selection": "all",
    "fact_token": "last",
    "lr": 2e-4,
    "v_num_grad_steps": 25,
    "v_lr": 5e-1,
    "v_loss_layer": 27,
    "v_weight_decay": 1e-1,
    "clamp_norm_factor": 4.0,
    "optim_num_step": 50,
    "ex_data_num": 20,
    "rewrite_module_tmp": "model.layers.{}.mlp.down_proj",
    "layer_module_tmp": "model.layers.{}",
    "mlp_module_tmp": "model.layers.{}.mlp",
    "attn_module_tmp": "model.layers.{}.self_attn",
    "ln_f_module": "model.norm",
    "lm_head_module": "lm_head",
    "window_size": 40,
    "overlap": 0,

    "use_gnn": false,
    "gnn_hidden_dim": 4096,
    "gnn_num_layers": 2,
    "gnn_dropout": 0.1,
    "gnn_lr": 1e-1,
    "gnn_weight_decay": 1e-1,
    "gnn_delta_scale": 0.1,

    "critical_token_weight": 3.0,

    "use_early_stopping": false,
    "early_stop_patience": 10,
    "early_stop_threshold": 0.005,

    "use_adapter": true,
    "adapter_hidden_dim": 1024,
    "adapter_num_layers": 2,
    "adapter_activation": "gelu",
    "adapter_dropout": 0.1,
    "adapter_lr": 1e-1,
    "adapter_weight_decay": 1e-1
}
